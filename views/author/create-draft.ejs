<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title>Create Draft</title>
</head>
<body>
    <header>
        <div class="header">
            <a href="/author/home">
                <img src="/images/logo.png" alt="Logo" class="logo">
            </a>
        
            <div class="header-right">
                <p style="text-align: right; white-space: nowrap;">Hello, <%= username %></p>
        
                <div class="dropdown">
                    <button class="dropbtn">
                        <img src="/images/menu-button.png" alt="Menu" class="menu-icon">
                    </button>
        
                    <div class="dropdown-content">
                        <a href="/author/settings" class="dropdown-item">Settings</a>
                        <a href="/" class="dropdown-item">Logout</a>
                    </div>
                </div>
            </div>
        </div>
        <br>
        <hr class="line">
    </header>

    <nav>
        <form action="/author/home" method="get" class="inline">
            <button type="submit" class="create-button">Home</button>
        </form>
        <form action="/author/create-blog" method="get" class="inline">
            <button type="submit" class="create-button">Create New Blog</button>
        </form>
        <form action="/author/create-draft" method="get" class="inline">
            <button type="submit" class="create-button">Create New Draft</button>
        </form>
        <form action="/author/draft-articles" method="get" class="inline">
            <button type="submit" class="create-button">Draft Articles</button>
        </form>
    </nav>
    <hr class="line">
    <br>
    <h1 class="center">Create a New Draft</h1>
    <hr class="dotted-line">
    <br><br>
    <form action="/author/create-draft" method="post" class="center">
        <p class="bold">Blog:
            <select name="blog_id" required>
                <% blogs.forEach(blog => { %>
                    <option value="<%= blog.blog_id %>"><%= blog.blog_name %></option>
                <% }); %>
            </select>
        </p>
        
        <label for="title" class="bold">Title:</label>
        <input type="text" id="title" name="title" required style="margin: 0;">
        <br><br>
        
        <label for="content" class="bold">Content:</label>
        <br>
        <textarea id="content" name="content" rows="15" cols="40" style="margin: 0;" required></textarea>
        <br><br>

        <button type="submit" class="normal-button" style="margin: 0;">Save Draft</button><br><br>
        <button type="button" onclick="window.location.href='/author/home';" class="flip-button" style="margin: 0;">Cancel</button>
    </form>

    <br><br><br><br>
</body>
</html>
