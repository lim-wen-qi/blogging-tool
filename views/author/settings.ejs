<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title>Edit Author Settings</title>
</head>
<header>
    <div class="header">
        <a href="/author/home">
            <img src="/images/logo.png" alt="Logo" class="logo">
        </a>
    
        <div class="header-right">
            <p style="text-align: right; white-space: nowrap;">Hello, <%= username %></p>
    
            <div class="dropdown">
                <button class="dropbtn">
                    <img src="/images/menu-button.png" alt="Menu" class="menu-icon">
                </button>
    
                <div class="dropdown-content">
                    <a href="/author/settings" class="dropdown-item">Settings</a>
                    <a href="/" class="dropdown-item">Logout</a>
                </div>
            </div>
        </div>
    </div>
    <br>
    <hr class="line">
</header>
<body>
    <nav>
        <form action="/author/home" method="get" class="inline">
            <button type="submit" class="create-button">Home</button>
        </form>
        <form action="/author/create-blog" method="get" class="inline">
            <button type="submit" class="create-button">Create New Blog</button>
        </form>
        <form action="/author/create-draft" method="get" class="inline">
            <button type="submit" class="create-button">Create New Draft</button>
        </form>
        <form action="/author/draft-articles" method="get" class="inline">
            <button type="submit" class="create-button">Draft Articles</button>
        </form>
    </nav>
    <hr class="line">
    <br>
    <h1 class="center">Edit Author Settings</h1>
    <br>
    <form action="/author/settings" method="post" class="center">
        <h2 class="blog-title">Author Details</h2>
        <br>
        <label for="username" class="bold">Username:</label>
        <span><%= user.user_name %></span><br><br>

        <label for="new_username" class="bold">New Username:</label><br>
        <input type="text" id="new_username" name="new_username" value="<%= user.user_name %>" required><br><br>
        
        <label for="new_password" class="bold">New Password:</label><br>
        <input type="password" id="new_password" name="new_password"><br><br>
        <br>
        <h2 class="blog-title">Blog Details</h2>
        <br>
        <label for="blog_selector" class="bold">Select a Blog to Change Name:</label><br>
        <select id="blog_selector" name="blog_selector" required>
            <% blogs.forEach(function(blog) { %>
                <option value="<%= blog.blog_id %>"><%= blog.blog_name %></option>
            <% }); %>
        </select>
        <br><br>
        <label for="new_blog_name" class="bold">New Blog Name:</label>
        <br>
        <input type="text" id="new_blog_name" name="new_blog_name">
        <br><br><br>
        <button type="submit" class="no-margin normal-button">Save Settings</button>
    </form>
    <br>
    <form action="/author/home %>" method="get" class="center">
        <button type="submit" class="no-margin flip-button">Back to Home</button>
    </form>
    <br><br><br><br>
</body>
</html>