<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title>Reader Login</title>
</head>
<body>
    <h1 class="login-title">Reader Login</h1><br>
    <form action="/reader/login" method="post" class="center">
        <p class="bold">Username or Email <br> <input id="identifier" type="text" name="identifier" required/></p>
        <br>
        <p class="bold">Password <br><input id="password" type="password" name="password" required/></p>
        <br>
        <button type="submit" class="bold no-margin login-button">Login</button>
    </form> 
    <br>
    <form action="/ %>" method="get" class="center">
        <button type="submit" class="flip-button no-margin ">Back</button>
    </form>
</body>
</html>